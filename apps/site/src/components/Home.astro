---
import { ui } from "../i18n/ui.mjs";
import { getModel } from "../lib/pages.mjs";
const { lang } = Astro.props;
const t = ui[lang];
const reference = getModel().link("reference", lang);
---
<p class="lede">{t.lede}</p>
<h2 id="what">{t.whatH}</h2>
<p>{t.whatP}</p>
<h2 id="reference">{t.referenceH}</h2>
<p>{t.referenceP}</p>
<p><a href={reference.href} lang={reference.lang} hreflang={reference.hreflang}>{lang === "nl" ? reference.label : t.referenceLink}</a></p>
