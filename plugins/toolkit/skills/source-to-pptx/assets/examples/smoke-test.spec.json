{
 "_purpose": "Exercises every element type the builder supports, so a change to draw.py or build_deck.py is caught before it reaches a real job.",
 "deck": {
  "output": "smoke.pptx",
  "slide_w_in": 13.3333,
  "slide_h_in": 7.5,
  "theme": {"accent1": "0B2240", "accent2": "DDA92F", "major_font": "Arimo", "minor_font": "Arimo"},
  "fonts": {"dir": "fonts", "embed": true,
            "families": {"Arimo": {"regular": "Arimo-Regular.ttf", "bold": "Arimo-Bold.ttf"}}}
 },
 "defaults": {"px_per_in": 115.2, "font": "Arimo", "color": "0B2240", "pt": 14},
 "slides": [
  {
   "name": "Element smoke test",
   "background": "FFFFFF",
   "elements": [
    {"type": "text", "name": "heading", "left_px": 60, "width_px": 1400, "baseline_px": 70,
     "align": "l", "runs": [{"t": "Every element type", "pt": 30, "b": true}]},
    {"type": "line", "name": "rule", "from_px": [60, 90], "to_px": [1476, 90],
     "color": "DDA92F", "width_pt": 1.5},

    {"type": "rect", "name": "plain rect", "box_px": [60, 120, 300, 260],
     "fill": "0B2240", "radius_px": 16, "shadow": true},
    {"type": "rect", "name": "outlined rect", "box_px": [320, 120, 560, 260],
     "fill": "FCFCFD", "line": "DDA92F", "line_pt": 1.0, "radius_px": 16},
    {"type": "rect", "name": "gradient rect", "box_px": [580, 120, 820, 260],
     "gradient": ["16355A", "0B2240"], "radius_px": 16},
    {"type": "ellipse", "name": "ellipse", "box_px": [840, 120, 1000, 260],
