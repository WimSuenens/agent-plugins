---
import "../styles/tokens.css";
import "../styles/base.css";
import { ui } from "../i18n/ui.mjs";
import { langScript } from "../lib/langScript.mjs";
const { lang, title, alternates = [] } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <script is:inline set:html={langScript(base)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <slot />
    <footer><div class="page">{t.footer}</div></footer>
  </body>
</html>
