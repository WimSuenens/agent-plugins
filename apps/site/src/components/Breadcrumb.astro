---
import { ui } from "../i18n/ui.mjs";
import { getModel } from "../lib/pages.mjs";
const { slug, lang } = Astro.props;
const trail = getModel().breadcrumb(slug, lang);
---
<nav data-nav="breadcrumb" aria-label={ui[lang].breadcrumbNav}>
  <ol>
    {trail.map((c, i) => i < trail.length - 1 ? <li><a href={c.href}>{c.label}</a></li> : <li aria-current="page">{c.label}</li>)}
  </ol>
</nav>
