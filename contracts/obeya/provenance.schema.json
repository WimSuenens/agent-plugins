{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Provenance",
  "description": "Where an object came from: settled on the main line, in flight on a named item, or fed by an event or live system.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "merged"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "in-flight"
        },
        "item": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "item"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "event"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  ]
}
