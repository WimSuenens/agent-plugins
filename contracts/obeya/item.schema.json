{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Item",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "factoryStatus": {
      "type": "string"
    },
    "kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "effort": {
      "description": "The effort this item belongs to: its parent map.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "number",
            "title"
          ],
          "additionalProperties": false
        }
      ]
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "required": [
    "id",
    "number",
    "title",
    "url",
    "factoryStatus",
    "kind",
    "role",
    "effort",
    "provenance"
  ],
  "additionalProperties": false
}
