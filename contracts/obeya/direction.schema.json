{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Direction",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string"
    },
    "current": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "description": "What changed the direction and when, oldest first.",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "change": { "type": "string", "minLength": 1 }
        },
        "required": ["date", "change"],
        "additionalProperties": false
      }
    },
    "ref": {
      "type": "string"
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "required": [
    "id",
    "goal",
    "current",
    "history",
    "ref",
    "provenance"
  ],
  "additionalProperties": false
}
