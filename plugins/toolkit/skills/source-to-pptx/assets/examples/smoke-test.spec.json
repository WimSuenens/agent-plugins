              ["Region A", "90", "€200M"],
              ["Region B", "40", "€80M"],
              ["Region C", "30", "€60M"]],
     "pt": 12, "header_fill": "0B2240", "header_color": "FFFFFF", "body_fill": "F4F5F7"},

    {"type": "bullets", "name": "bullets", "left_px": 60, "width_px": 640,
     "first_baseline_px": 530, "spacing_px": 38, "pt": 14,
     "color": "0B2240",
     "bullet": {"char": "ü", "font": "Wingdings", "color": "DDA92F", "size_pct": 120, "offset_px": 38},
     "items": ["Reflowing bullet list", "Second item", "Third item"]},

    {"type": "group", "name": "icon row", "children": [
     {"type": "icon", "icon": "store", "center_x_px": 800, "top_px": 500, "height_px": 56, "color": "0B2240"},
     {"type": "icon", "icon": "growth", "center_x_px": 890, "top_px": 500, "height_px": 56, "color": "0B2240"},
     {"type": "icon", "icon": "target", "center_x_px": 980, "top_px": 500, "height_px": 56, "color": "DDA92F"},
     {"type": "icon", "icon": "partnership", "center_x_px": 1070, "top_px": 500, "height_px": 56, "color": "0B2240"},
     {"type": "icon", "icon": "chart_pie", "center_x_px": 1160, "top_px": 500, "height_px": 56, "color": "0B2240"},
     {"type": "icon", "icon": "gear", "center_x_px": 1250, "top_px": 500, "height_px": 56, "color": "0B2240"},
     {"type": "icon", "icon": "arrow_up", "center_x_px": 1340, "top_px": 500, "height_px": 56, "color": "DDA92F"},
     {"type": "icon", "icon": "star", "center_x_px": 1430, "top_px": 500, "height_px": 56, "color": "DDA92F"}
    ]},

    {"type": "freeform", "name": "inline freeform", "box_px": [60, 660, 200, 760],
     "d": "M0,40 C0,18 18,0 40,0 L100,0 C122,0 140,18 140,40 L140,60 C140,82 122,100 100,100 L40,100 C18,100 0,82 0,60 Z",
     "keep_aspect": "left", "fill": "DDA92F"},

    {"type": "text", "name": "footer", "left_px": 60, "width_in": 3.0,
     "baseline_in": 7.15, "align": "l",
     "runs": [{"t": "smoke test", "pt": 10, "c": "9E9EA0"}]}
   ]
  }
 ]
}
