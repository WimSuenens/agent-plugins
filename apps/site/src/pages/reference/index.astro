---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Toc from "../../components/Toc.astro";
import { loadSkills } from "../../lib/skills.mjs";
const skills = loadSkills();
const groups = new Map();
for (const s of skills) groups.set(s.plugin, [...(groups.get(s.plugin) ?? []), s]);
---
<Base lang="en" title="Reference - Agent plugins">
  <Breadcrumb />
  <h1>Reference</h1>
  <p>Every skill of every plugin in this marketplace, generated from the plugins' own SKILL.md files.</p>
  <Toc plugins={[...groups.keys()]} />
  {[...groups].map(([plugin, list]) => (
    <section>
      <h2 id={plugin}>{plugin}</h2>
      {list.map((s) => (
        <article data-skill-entry data-plugin={s.plugin} data-name={s.name}>
          <h3>{s.name}</h3>
          <p><code data-field="command">{s.command}</code>{s.manual && <span data-field="manual">manual command</span>}</p>
          <p data-field="description">{s.description.trim()}</p>
          {s.argumentHint && <p data-field="argument-hint">Argument hint: <code>{s.argumentHint}</code></p>}
        </article>
      ))}
    </section>
  ))}
</Base>
