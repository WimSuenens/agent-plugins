{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PendingDecision",
  "description": "A decision card that still waits for the person.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "item": { "type": ["integer", "null"] },
    "title": { "type": "string", "minLength": 1 },
    "door": { "enum": ["one-way", "two-way"] },
    "askedOf": { "type": "string", "minLength": 1 },
    "since": { "type": "string", "minLength": 1 },
    "options": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2 },
    "ref": { "type": "string" },
    "provenance": { "$ref": "provenance.schema.json" }
  },
  "required": ["id", "item", "title", "door", "askedOf", "since", "options", "ref", "provenance"],
  "additionalProperties": false
}
