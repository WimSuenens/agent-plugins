{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "adr",
        "decision-card"
      ]
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "order": {
      "type": [
        "integer",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "ref": {
      "description": "Where the artifact can be found, in the source's own terms (a path, a url).",
      "type": "string"
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "status",
    "order",
    "date",
    "ref",
    "provenance"
  ],
  "additionalProperties": false
}
