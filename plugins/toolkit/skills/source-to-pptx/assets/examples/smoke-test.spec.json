    {"type": "ellipse", "name": "ring", "box_px": [1020, 120, 1180, 260],
     "line": "0B2240", "line_pt": 2.0},

    {"type": "textbox", "name": "wrapped copy", "box_px": [60, 290, 700, 470],
     "align": "j", "line_spacing_pt": 20, "space_after_pt": 8,
     "paragraphs": [
      [{"t": "A wrapped block, placed by its box rather than a baseline, which is what body copy on a document page needs.", "pt": 13}],
      [{"t": "A second paragraph, with ", "pt": 13},
       {"t": "bold", "pt": 13, "b": true},
       {"t": " and ", "pt": 13},
       {"t": "italic", "pt": 13, "i": true},
       {"t": " runs in it.", "pt": 13}]
     ]},

    {"type": "table", "name": "table", "box_px": [740, 290, 1476, 470],
